{
    "name": "deployowl",
    "version": "2.3.0",
    "description": "Error tracking SDK for DeployOwl",
    "files": [
        "dist"
    ],
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "require": "./dist/index.js",
            "import": "./dist/index.mjs"
        }
    },
    "scripts": {
        "build": "tsup src/index.ts --format cjs,esm --dts",
        "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
        "lint": "tsc --noEmit"
    },
    "keywords": [
        "error-tracking",
        "monitoring",
        "observability",
        "edge",
        "sentry",
        "crash-reporting",
        "telemetry"
    ],
    "author": "DeployOwl",
    "license": "Proprietary",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/deployowl/deployowl-sdk.git"
    },
    "bugs": {
        "url": "https://github.com/deployowl/deployowl-sdk/issues"
    },
    "homepage": "https://github.com/deployowl/deployowl-sdk#readme",
    "devDependencies": {
        "@types/node": "^20.10.0",
        "tsup": "^8.0.0",
        "typescript": "^5.3.0"
    }
}
